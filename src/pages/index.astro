---
import BaseLayout from "../layouts/BaseLayout.astro";

const currentYear = new Date().getFullYear();
---

<BaseLayout>
  <main class="page-shell">
    <div class="screen-noise" aria-hidden="true"></div>
    <div class="scan-sweep" id="scan-sweep" aria-hidden="true"></div>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="grid-fade"></div>
    <div class="crosshair crosshair-one" aria-hidden="true"></div>
    <div class="crosshair crosshair-two" aria-hidden="true"></div>

    <section class="hero-stage">
      <header class="site-nav">
        <p class="brand">Danny Mayorga</p>
        <nav class="nav-links" aria-label="Primary">
          <a href="https://www.linkedin.com/in/dannymayorga/" target="_blank" rel="noreferrer">LinkedIn</a>
        </nav>
      </header>

      <div class="hero-layout">
        <article class="hero-copy">
          <h1>Coming soon.</h1>
          <p class="lede">
            Site in progress. Exploring intelligent products, design-led systems, and new ways to create
            value through AI.
          </p>
          <a class="cta" href="https://www.linkedin.com/in/dannymayorga/" target="_blank" rel="noreferrer">
            LinkedIn
          </a>
        </article>

        <div class="hero-visual" aria-hidden="true">
          <div class="glow-ring" id="glow-ring">
            <div class="ring-sweep" id="ring-sweep"></div>
            <div class="glow-core" id="glow-core"></div>
          </div>
        </div>
      </div>

      <footer class="site-footer">
        <p>© {currentYear} Danny Mayorga</p>
      </footer>
    </section>
  </main>

  <script>
    import { gsap } from "gsap";

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!prefersReducedMotion.matches) {
      gsap.set(["#glow-ring", "#glow-core", "#ring-sweep", ".hero-copy", ".site-footer"], {
        willChange: "transform, filter, opacity",
      });

      gsap.set(".hero-stage", {
        filter: "blur(14px) brightness(0.8)",
      });

      const intro = gsap.timeline({ defaults: { ease: "power3.out" } });

      intro.to(".hero-stage", {
        filter: "blur(0px) brightness(1)",
        duration: 0.48,
        ease: "power2.out",
      });

      intro.to(
        ".hero-stage",
        {
          filter: "blur(2px) brightness(0.96)",
          duration: 0.14,
          ease: "power1.inOut",
          yoyo: true,
          repeat: 1,
        },
        0.5
      );

      intro.fromTo(
        "#scan-sweep",
        {
          yPercent: -140,
          opacity: 0,
        },
        {
          yPercent: 140,
          opacity: 0.28,
          duration: 0.72,
          ease: "power2.out",
        },
        0.05
      );

      intro.to(
        "#scan-sweep",
        {
          opacity: 0,
          duration: 0.22,
          ease: "power2.out",
        },
        0.58
      );

      intro.fromTo(
        "#glow-ring",
        {
          opacity: 0.2,
          scale: 0.86,
          rotation: -30,
          filter: "saturate(0.82) brightness(0.88)",
        },
        {
          opacity: 1,
          scale: 1,
          rotation: -18,
          filter: "saturate(1) brightness(1)",
          duration: 1.15,
        }
      );

      intro.fromTo(
        "#glow-core",
        { scale: 0.88, opacity: 0.35 },
        { scale: 1, opacity: 1, duration: 1.05 },
        0
      );

      gsap.to("#glow-ring", {
        rotateZ: -12,
        duration: 8,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
        transformOrigin: "50% 50%",
        delay: 1.15,
      });

      gsap.to("#glow-core", {
        scale: 0.96,
        duration: 4.2,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
        transformOrigin: "50% 50%",
        delay: 1.15,
      });

      gsap.fromTo(
        "#ring-sweep",
        {
          rotation: 0,
          opacity: 0.42,
        },
        {
          rotation: 360,
          opacity: 0.42,
          duration: 2.4,
          repeat: -1,
          ease: "none",
          transformOrigin: "50% 50%",
        }
      );

      gsap.to(".screen-noise", {
        opacity: 0.13,
        duration: 0.09,
        repeat: -1,
        yoyo: true,
        ease: "steps(2)",
      });

      gsap.to("#scan-sweep", {
        yPercent: 140,
        opacity: 0.1,
        duration: 4.5,
        repeat: -1,
        repeatDelay: 2.5,
        ease: "none",
        delay: 1.4,
      });
    }
  </script>
</BaseLayout>
